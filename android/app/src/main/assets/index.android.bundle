      color: '#212121',
      fontWeight: '500'
    },
    redDayText: {
      color: '#D32F2F',
      fontWeight: 'bold'
    },
    todayText: {
      fontWeight: 'bold',
      color: '#1976D2'
    },
    disabledText: {
      color: '#BDBDBD'
    },
    amountText: {
      fontSize: 10,
      fontWeight: 'bold',
      marginTop: 1
    },
    /* 주간 뷰 스타일 */
    weeklyScrollView: {
      flex: 1
    },
    weeklyContent: {
      padding: 16
    },
    weekHeader: {
      flexDirection: 'row',
      justifyContent: 'space-between',
      alignItems: 'center',
      backgroundColor: '#FFFFFF',
      paddingVertical: 12,
      paddingHorizontal: 16,
      borderRadius: 12,
      marginBottom: 12,
      elevation: 2,
      shadowColor: '#000000',
      shadowOffset: {
        width: 0,
        height: 1
      },
      shadowOpacity: 0.1,
      shadowRadius: 2
    },
    weekArrowButton: {
      paddingHorizontal: 8,
      paddingVertical: 4
    },
    weekArrowText: {
      fontSize: 13,
      color: '#2196F3',
      fontWeight: '600'
    },
    weekTitleContainer: {
      alignItems: 'center'
    },
    weekTitleText: {
      fontSize: 15,
      fontWeight: 'bold',
      color: '#212121'
    },
    todayResetButton: {
      alignSelf: 'center',
      marginBottom: 12,
      paddingHorizontal: 12,
      paddingVertical: 6,
      backgroundColor: '#E3F2FD',
      borderRadius: 16
    },
    todayResetText: {
      fontSize: 12,
      color: '#1976D2',
      fontWeight: '600'
    },
    weeklyCardItem: {
      backgroundColor: '#FFFFFF',
      borderRadius: 12,
      padding: 16,
      marginBottom: 10,
      elevation: 1,
      shadowColor: '#000000',
      shadowOffset: {
        width: 0,
        height: 1
      },
      shadowOpacity: 0.05,
      shadowRadius: 2
    },
    weeklyCardItemToday: {
      borderWidth: 2,
      borderColor: '#2196F3',
      backgroundColor: '#F1F8E9'
    },
    weeklyCardHeader: {
      flexDirection: 'row',
      justifyContent: 'space-between',
      alignItems: 'center',
      borderBottomWidth: 1,
      borderBottomColor: '#F0F0F0',
      paddingBottom: 10,
      marginBottom: 10
    },
    weeklyCardTitleRow: {
      flexDirection: 'row',
      alignItems: 'center'
    },
    weeklyDayName: {
      fontSize: 15,
      fontWeight: 'bold',
      color: '#212121'
    },
    weeklyRedDayName: {
      color: '#D32F2F'
    },
    weeklyDayNameToday: {
      color: '#1565C0'
    },
    todayBadge: {
      marginLeft: 8,
      backgroundColor: '#2196F3',
      paddingHorizontal: 6,
      paddingVertical: 2,
      borderRadius: 4
    },
    todayBadgeText: {
      color: '#FFFFFF',
      fontSize: 10,
      fontWeight: 'bold'
    },
    statusBadge: {
      fontSize: 12,
      fontWeight: 'bold'
    },
    weeklyCardBody: {
      gap: 4
    },
    weeklyInfoRow: {
      flexDirection: 'row',
      justifyContent: 'space-between',
      alignItems: 'center'
    },
    weeklyInfoLabel: {
      fontSize: 13,
      color: '#616161'
    },
    weeklyInfoValue: {
      fontSize: 13,
      color: '#212121',
      fontWeight: '500'
    },
    weeklySpentValue: {
      fontSize: 14,
      fontWeight: 'bold'
    }
